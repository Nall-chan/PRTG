<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/11.5/phpunit.xsd" bootstrap="stubs/autoload.php" colors="true">
    <testsuites>
        <testsuite name="PRTG">
            <directory suffix="Test.php">.</directory>
            <exclude>stubs</exclude>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory suffix=".php">../PRTGConfigurator</directory>
            <directory suffix=".php">../PRTGDevice</directory>
            <directory suffix=".php">../PRTGIO</directory>
            <directory suffix=".php">../PRTGSensor</directory>
            <directory suffix=".php">../libs</directory>
        </include>
        <exclude>
            <directory>../libs/helper</directory>
        </exclude>
    </source>
    <php>
        <const name="PHPUNIT_TESTSUITE" value="true"/>
    </php>
</phpunit>
